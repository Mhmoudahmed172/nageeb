APP_NAME=نجيب
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Production:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.example

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: LOG_LEVEL=error

# Local development (SQLite). Hosted/test deploys use Lakebase Postgres (Neon).
# After `neon link`, `neon env pull` writes DATABASE_URL (pooled) and
# DATABASE_URL_UNPOOLED (direct — use this for php artisan migrate).
DB_CONNECTION=pgsql
DB_URL="${DATABASE_URL}"
DB_HOST=
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# DATABASE_URL=
# DATABASE_URL_UNPOOLED=
# NEON_BRANCH=
# Neon Auth is provisioned on the project; Nageeb still uses Laravel auth.
# NEON_AUTH_BASE_URL=
# NEON_AUTH_JWKS_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Production (HTTPS): SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log

# Application default disk. Protected media uses MEDIA_DISK.
FILESYSTEM_DISK=local
MEDIA_DISK=local
# Production object storage (private bucket, no public ACL):
# FILESYSTEM_DISK=s3
# MEDIA_DISK=s3

QUEUE_CONNECTION=sync
# Jobs table exists if you later queue work: QUEUE_CONNECTION=database
# Then run: php artisan queue:work

CACHE_STORE=database
# CACHE_PREFIX=

# Behind a TLS terminator / load balancer (required on Vercel):
TRUSTED_PROXIES=*

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Production SMTP example:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=noreply@example.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
